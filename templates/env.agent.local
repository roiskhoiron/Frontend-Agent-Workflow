# Akun uji untuk agen QA/Validator (kit Frontend web).
# WAJIB: tambahkan `.env.agent.local` ke .gitignore SEBELUM file ini diisi.
# Hanya dev/staging (kecuali QA_LIVE_*: akun uji production khusus smoke live, baca saja).
# Isi tidak pernah ditulis ke laporan, tiket, PR/MR, atau commit.
QA_ENV=staging
QA_BASE_URL=
QA_API_BASE_URL=
QA_USER1_EMAIL=
QA_USER1_PASSWORD=
QA_USER2_EMAIL=
QA_USER2_PASSWORD=
QA_LIVE_USER1_EMAIL=
QA_LIVE_USER1_PASSWORD=
